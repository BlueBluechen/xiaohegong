  <Box style={{ position: 'absolute', left: 76, top: 96, width: 54, height: 1, backgroundColor: 'rgba(201,162,75,0.55)' }} />

  <Text style={{ position: 'absolute', left: 76, top: 108, width: 900, fontFamily: 'PingFang SC', fontSize: 15, lineHeight: 1.8, color: '#5C6B6B' }}>
    孩子以为在盖章，其实在给这条河建档。下面这些字段，是按研究机构能直接用的格式设计的。
  </Text>

  {/* 左：七个字段，三列（字段 / 取值 / 为什么这么设计） */}
  <Box style={{ position: 'absolute', left: 76, top: 168, width: 700 }}>
    <Box style={{ display: 'flex', paddingBottom: 8, borderBottom: '1px solid rgba(201,162,75,0.4)' }}>
      <Text style={{ width: 96, fontFamily: 'PingFang SC', fontSize: 12, letterSpacing: 1.5, color: '#8A7A52' }}>字段</Text>
      <Text style={{ width: 246, fontFamily: 'PingFang SC', fontSize: 12, letterSpacing: 1.5, color: '#8A7A52' }}>示例</Text>
      <Text style={{ flex: 1, fontFamily: 'PingFang SC', fontSize: 12, letterSpacing: 1.5, color: '#8A7A52' }}>为什么这么设计</Text>
    </Box>
    {[
      ['点位', '清河闸 · 点位 05', '空间可比：同一处才谈得上变化'],
      ['时间', '10-22 14:32', '时间序列：单次记录没有意义'],
      ['类型', '水文 / 物种 / 岸线 / 异常', '决定这条记录该给谁看'],
      ['观测', '透明度：低；白鹭 ×2', '有数值才能统计、作图'],
      ['证据', '照片 1 张', '可复核：能回看当时的样子'],
      ['观察者', 'NO.057 · 巡河员', '可信度加权：级别即数据权重'],
      ['环境', '天气 / 水位 / 时段', '排除干扰：阴天的水色不算异常'],
      ['许可', 'CC BY-NC 4.0 · 匿名', '机构敢用：授权先写清楚'],
    ].map(([f, v, w], i) => (
      <Box key={i} style={{ display: 'flex', alignItems: 'center', height: 40, borderBottom: '1px solid rgba(7,47,53,0.08)' }}>
        <Text style={{ width: 96, fontFamily: 'Songti SC', fontSize: 16, letterSpacing: 1, color: '#072F35' }}>{f}</Text>
        <Text style={{ width: 246, fontFamily: 'PingFang SC', fontSize: 13.5, color: '#5C6B6B' }}>{v}</Text>
        <Text style={{ flex: 1, fontFamily: 'PingFang SC', fontSize: 12.5, color: '#8A7A52' }}>{w}</Text>
      </Box>
    ))}
